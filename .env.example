# ============================================================
# THLPro — Variáveis de ambiente (copie para .env e ajuste)
# cp .env.example .env
# ============================================================

# ---- Banco de dados (PostgreSQL) ----
POSTGRES_USER=thlpro
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=thlpro

# ---- Backend (DATABASE_URL usado dentro do container docker-compose) ----
# Fora do docker (execução local), o backend usa o .env de backend/
DATABASE_URL=postgresql+asyncpg://thlpro:troque-esta-senha@db:5432/thlpro
USE_REDIS=false
REDIS_URL=redis://redis:6379/0

# ---- Segurança ----
# TROQUE este valor em produção (ex.: openssl rand -hex 32)
SECRET_KEY=troque-esta-chave-secreta
ACCESS_TOKEN_EXPIRE_HOURS=8

# ---- Usuário administrador inicial ----
ADMIN_EMAIL=admin@thlpro.local
ADMIN_PASSWORD=troque-esta-senha-admin

# ---- CORS (origens que podem chamar a API) ----
CORS_ORIGINS=http://localhost,https://localhost,http://localhost:5173

# ---- Ajustes ----
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_DIR=./logs
DEFAULT_TIMEZONE=America/Sao_Paulo
MAX_FUTURE_SKEW_SECONDS=300
API_WORKERS=2

# ---- Cliente Windows (.exe) — usado pelo usuário na máquina com Profit ----
# THLPRO_SERVER_URL=https://seuservidor.com
# THLPRO_CLIENT_NAME=operacao-1
